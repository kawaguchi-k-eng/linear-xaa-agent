# --- NextAuth / Auth.js core ---
# Generate with: npx auth secret
AUTH_SECRET=
# Base URL of THIS app (used for the OAuth callback). Must match the port
# you actually run on — a mismatch here causes a confusing redirect_uri
# error at Okta, not an error from this app. In Amplify, set to the
# deployed URL.
AUTH_URL=http://localhost:3002

# --- Okta: used both for user sign-in (NextAuth Okta provider) AND, by default,
# as the "Requesting App" credentials for the XAA token-exchange step. ---
# Issuer AS CONFIGURED FOR SIGN-IN, e.g. https://your-org.okta.com/oauth2/default
# (a custom authorization server). This is correct for normal OIDC login.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Optional override: only set these if you registered a SEPARATE Okta app
# specifically for the XAA token exchange, distinct from the sign-in app above.
# OKTA_REQUESTING_APP_CLIENT_ID=
# OKTA_REQUESTING_APP_CLIENT_SECRET=
# ID-JAG exchange only works against the ORG authorization server, never a
# custom one (e.g. NOT .../oauth2/default/v1/token) — even though
# /oauth2/default above is correct for sign-in. Defaults to
# `${origin of OKTA_ISSUER}/oauth2/v1/token`; override only if that's wrong.
# OKTA_ORG_TOKEN_URL=https://your-org.okta.com/oauth2/v1/token

# --- Okta XAA resource connection (Taskboard0, our self-hosted demo resource app) ---
# Taskboard0's own "Issuer URL", set in its Cross App Access (XAA) Callers
# config in Okta. This — NOT the Audience/tenant ID — is the `audience` the
# ORG authorization server expects on the ID-JAG request.
#
# This MUST be a real URL that Okta can actually reach — Okta's own field
# description says it's used "for token verification requests," and it
# means it. A placeholder domain will pass Okta's save-time validation
# (which just rejects literal "localhost") but fail silently at request
# time with a confusing `access_denied: User is not assigned to the
# client application` error. Once Taskboard0 is deployed somewhere real,
# use that same URL here and for Taskboard0's own RESOURCE_AUDIENCE.
RESOURCE_ISSUER_URL=https://your-deployed-taskboard0-url
# The "Resource identifier" you set when creating the XAA connection in Okta
# (Directory > AI Agents > <agent> > Resource connections) — same value as
# Taskboard0's own "Audience/tenant ID" in its XAA Callers config, and as
# Taskboard0's own RESOURCE_AUDIENCE env var. In practice this ends up being
# the same value as RESOURCE_ISSUER_URL above.
RESOURCE_IDENTIFIER=https://your-deployed-taskboard0-url
# Space-separated scopes to request.
RESOURCE_SCOPES="read write"

# --- Taskboard0's own authorization server (receives the ID-JAG) ---
RESOURCE_TOKEN_URL=https://your-deployed-taskboard0-url/oauth/token
# The client id this app is registered under AT Taskboard0 (must be one of
# the values in Taskboard0's TRUSTED_REQUESTING_APP_CLIENT_IDS, and the
# "external client ID" you entered in the Okta XAA resource connection).
# Note: Taskboard0's own /oauth/token implementation doesn't actually check
# this value — it trusts the client_id embedded in the verified ID-JAG
# instead — but a real resource app's authorization server may require it.
RESOURCE_EXTERNAL_CLIENT_ID=
# RESOURCE_EXTERNAL_CLIENT_SECRET=

# Base URL of the Taskboard0 REST API — the same app as RESOURCE_TOKEN_URL
# above (see src/lib/taskboard.ts).
TASKBOARD_API_URL=https://your-deployed-taskboard0-url

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
